<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hello VHTML (hand-written)</title>
    <style>
      html, body { margin: 0; background: #070c16; }
      .stage { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-family: system-ui, sans-serif; }
      .eyebrow { font-size: 26px; letter-spacing: .42em; color: #6ee7ff; font-weight: 700; }
      h1 { font-size: 136px; letter-spacing: -5px; margin: 18px 0 0; }
      p { font-size: 34px; color: #93a9cc; margin-top: 26px; }
    </style>
  </head>
  <body>
    <vhtml version="1.1">
      <project id="hello-handwritten" version="1.1" title="Hello VHTML">
        <settings>
          <composition width="1920" height="1080" frame-rate="30/1" duration="5s" background="#070c16" />
        </settings>
        <scenes>
          <scene id="hello" duration="5s">
            <div class="stage">
              <div>
                <div class="eyebrow">VHTML 1.1</div>
                <h1>Hello, video.</h1>
                <p>HTML and CSS, on a real timeline, rendered deterministically.</p>
              </div>
            </div>
          </scene>
        </scenes>
        <timelines>
          <timeline id="main" duration="5s">
            <lane id="visual" type="video">
              <clip id="hello-clip" ref="scene:hello" start="0s" duration="5s">
                <animate property="opacity" from="0" to="1" duration="0.8s" easing="ease-out" />
                <animate property="scale" from="1.04" to="1" duration="5s" easing="ease-out" />
              </clip>
            </lane>
            <lane id="captions" type="caption" caption-style="font-size:30px;bottom:8%">
              <cue id="cue1" start="0.8s" duration="3.4s" text="Code is the source of truth." />
            </lane>
          </timeline>
        </timelines>
        <outputs>
          <output id="mp4" format="mp4" width="1920" height="1080" frame-rate="30/1" path="out/hello.mp4" />
        </outputs>
      </project>
    </vhtml>
  </body>
</html>
