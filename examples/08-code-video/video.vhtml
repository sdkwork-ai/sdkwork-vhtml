<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Code-Authored Video</title>
</head>
<body>
<vhtml version="1.1">
<project id="code-video" version="1.1" title="Code-Authored Video" description="One .vhtml file: data-driven scenes, generation tasks, time remap, nested timeline and audio ducking">
  <settings>
    <composition width="1280" height="720" frame-rate="30/1" duration="8s" background="#05070d" color-space="srgb" seed="11"></composition>
  </settings>
  <timelines>
    <timeline id="main" duration="8s"></timeline>
  </timelines>
</project>
<script type="application/vnd.vhtml.program+javascript">
// ---------------------------------------------------------------------------
// Everything below runs once, deterministically, when the document is loaded.
// Same file + same data + same runtime = same video.
// ---------------------------------------------------------------------------

const fps = vhtml.ctx.fps;
const styles = [
  'body { margin: 0; background: #05070d; color: #e8f4ff; font-family: "Segoe UI", system-ui, sans-serif; }',
  '.card { position: absolute; inset: 0; display: grid; place-items: center; }',
  '.card h2 { font-size: 84px; font-weight: 800; letter-spacing: -0.02em; margin: 0; }',
  '.card p { font-size: 32px; color: #7fa8c9; margin: 8px 0 0; }',
  '.stage { position: absolute; inset: 0; overflow: hidden; }',
];
for (const style of styles) vhtml.addStyle(style);

// ---- 1. Generation tasks: procedural visuals, music and sfx ---------------
vhtml.addGeneration({
  id: 'cover',
  kind: 'image',
  provider: 'procedural',
  prompt: 'abstract teal cover frame, soft gradient, premium product stage',
  constraints: { width: 1280, height: 720, seed: 11 },
});
vhtml.addGeneration({
  id: 'gradient',
  kind: 'video',
  provider: 'procedural',
  model: 'procedural-gradient-v1',
  prompt: 'slow drifting teal gradient with floating light',
  inputs: [{ ref: 'gen:cover', role: 'first-frame' }],
  constraints: { duration: '3s', width: 1280, height: 720, frameRate: '30/1', seed: 11 },
  rights: { commercialUse: true, aiDisclosure: true },
});
vhtml.addGeneration({
  id: 'score',
  kind: 'music',
  provider: 'procedural',
  prompt: 'minimal uplifting synth bed',
  constraints: { duration: '8s', sampleRate: 48000, seed: 11 },
  direction: { music: { bpm: 96, vocals: 'none', loop: false } },
});
vhtml.addGeneration({
  id: 'whoosh',
  kind: 'sfx',
  provider: 'procedural',
  prompt: 'soft transition whoosh',
  constraints: { duration: '0.6s', sampleRate: 48000, seed: 11 },
});

// ---- 2. Data-driven title cards (one scene per data row) ------------------
const features = vhtml.data.get('features');
const cards = features.map((feature, index) => ({
  start: index,
  scene: `card-${feature.id}`,
}));
for (const feature of features) {
  vhtml.addScene({
    id: `card-${feature.id}`,
    css: `.card h2 { color: ${feature.accent}; }`,
    html: vhtml.html`
      <div class="card">
        <div style="text-align:center">
          <h2>${feature.title}</h2>
          <p>${feature.subtitle}</p>
        </div>
      </div>`,
  });
}
vhtml.addLane({
  id: 'visual',
  type: 'video',
  clips: cards.map((card) =>
    vhtml.clip(`scene:${card.scene}`, {
      start: card.start,
      duration: 1,
      animations: [
        vhtml.animate({ property: 'opacity', from: 0, to: 1, duration: '0.25s', easing: 'ease-out' }),
      ],
    }),
  ),
});

// ---- 3. Generated hero shot with a time-remap speed ramp ------------------
// Fast push for the first second, then a slow drift.
vhtml.addClip('visual', {
  id: 'hero',
  ref: 'gen:gradient',
  start: 3,
  duration: 3,
  timeRemap: {
    keyframes: [
      { at: 0, source: 0 },
      { at: 1, source: 1.5, easing: 'ease-in-out' },
      { at: 3, source: 2.25 },
    ],
  },
});

// ---- 4. Nested timeline (compound clip) ----------------------------------
vhtml.addTimeline({ id: 'outro', duration: '2s' });
vhtml.addScene({ id: 'outro-end', html: '<div class="card"><div style="text-align:center"><h2>Authored as code.</h2></div></div>' });
vhtml.addLane({ id: 'outro-visual', type: 'video', clips: [] }, 'outro');
vhtml.addClip('outro-visual', { id: 'outro-a', ref: 'scene:card-ship', start: 0, duration: 1.3 });
vhtml.addClip('outro-visual', { id: 'outro-b', ref: 'scene:outro-end', start: 1, duration: 1 });
vhtml.addTransition('outro-visual', { fromClipId: 'outro-a', toClipId: 'outro-b', type: 'crossfade', duration: 0.3 });
vhtml.addClip('visual', { id: 'outro-compound', kind: 'timeline', ref: 'timeline:outro', start: 6, duration: 2 });

// ---- 5. Audio lanes: music ducks under the whoosh -------------------------
vhtml.addLane({ id: 'music', type: 'audio', clips: [] });
vhtml.addClip('music', {
  id: 'score-clip',
  ref: 'gen:score',
  start: 0,
  duration: 8,
  volume: 0.8,
  fadeIn: 0.5,
  fadeOut: 1,
  audioEffects: [vhtml.effect('ducking', {
    'sidechain-track': 'sfx',
    threshold: -24,
    reduction: 0.2,
    attack: 0.05,
    release: 0.4,
    hold: 0.2,
  })],
});
vhtml.addLane({ id: 'sfx', type: 'audio', clips: [] });
vhtml.addClip('sfx', { id: 'whoosh-clip', ref: 'gen:whoosh', start: 6, duration: 0.6, volume: 1 });

// ---- 6. Captions and markers generated from the same data ----------------
for (const feature of features) {
  vhtml.addCue({ text: feature.caption, start: features.indexOf(feature), duration: 1 });
}
vhtml.addMarker({ time: 3, name: 'hero', type: 'chapter' });
vhtml.addMarker({ time: 6, name: 'outro', type: 'chapter' });

// ---- 7. Output ------------------------------------------------------------
vhtml.addOutput({ id: 'main-mp4', format: 'mp4', path: 'renders/code-video.mp4' });

vhtml.info(`authored ${features.length} cards, 1 remap ramp, 1 compound clip, 3 generation tasks`);
</script>
<script type="application/json" id="features">
[
  { "id": "write", "title": "Write HTML", "subtitle": "Full browser rendering", "accent": "#6ee7ff", "caption": "HTML is the rendering engine" },
  { "id": "compose", "title": "Compose time", "subtitle": "A real timeline, in code", "accent": "#9d7bff", "caption": "Scenes, lanes and clips from loops" },
  { "id": "ship", "title": "Ship video", "subtitle": "Deterministic export", "accent": "#ffd166", "caption": "Deterministic frames, exact time" }
]
</script>
</vhtml>
</body>
</html>
