{
  "name": "@sdkwork/vhtml",
  "version": "1.1.3",
  "description": "VHTML 1.1 complete toolkit: core model, code-first SDK, deterministic renderer, media export, project management, generation, editor and Studio.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "default": "./dist/media.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "import": "./dist/generation.js",
      "default": "./dist/generation.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js",
      "default": "./dist/project.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js",
      "default": "./dist/studio.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "bin": {
    "vhtml": "./bin/vhtml.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declarations.mjs .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@sdkwork/vhtml-core": "workspace:^",
    "@sdkwork/vhtml-sdk": "workspace:^",
    "@sdkwork/vhtml-runtime": "workspace:^",
    "@sdkwork/vhtml-media": "workspace:^",
    "@sdkwork/vhtml-generation": "workspace:^",
    "@sdkwork/vhtml-project": "workspace:^",
    "@sdkwork/vhtml-editor": "workspace:^",
    "@sdkwork/vhtml-studio": "workspace:^",
    "@sdkwork/vhtml-schema": "workspace:^",
    "@sdkwork/vhtml-cli": "workspace:^"
  },
  "keywords": [
    "vhtml",
    "video",
    "html",
    "timeline",
    "deterministic-rendering"
  ],
  "publishConfig": {
    "access": "public"
  }
}
