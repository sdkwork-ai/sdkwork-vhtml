{
  "name": "@sdkwork/vhtml-ffmpeg",
  "version": "1.1.1",
  "description": "Small, dependency-free FFmpeg/ffprobe process helpers used by VHTML media, project and generation packages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declarations.mjs .",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "vhtml",
    "ffmpeg",
    "ffprobe",
    "media"
  ],
  "publishConfig": {
    "access": "public"
  }
}
