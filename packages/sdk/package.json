{
  "name": "@sdkwork/vhtml-sdk",
  "version": "1.1.3",
  "description": "Code-first VHTML authoring SDK: defineVideo, scenes, lanes, clips, animations, transitions, effects, captions, generation and outputs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declarations.mjs .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@sdkwork/vhtml-core": "workspace:^"
  },
  "keywords": [
    "vhtml",
    "sdk",
    "typescript",
    "video",
    "code-first"
  ],
  "publishConfig": {
    "access": "public"
  }
}
