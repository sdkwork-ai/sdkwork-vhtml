<!doctype html>
<html><body><vhtml version="1.1">
<project id="conf-program" version="1.1">
  <settings><composition width="320" height="180" frame-rate="30/1" duration="2s" seed="11" /></settings>
  <timelines><timeline id="main" duration="2s"></timeline></timelines>
</project>
<script type="application/vnd.vhtml.program+javascript">
vhtml.addLane({ id: 'v', type: 'video', clips: [] });
const lines = vhtml.data.get('lines');
for (let index = 0; index < lines.length; index += 1) {
  const line = lines[index];
  vhtml.addScene({ id: 'line-' + index, html: '<p>' + line + '</p>' });
  vhtml.addClip('v', { ref: 'scene:line-' + index, start: index * 0.5, duration: 0.5 });
}
</script>
<script type="application/json" id="lines">["one", "two", "three", "four"]</script>
</vhtml></body></html>
