<!doctype html>
<html><body><vhtml version="1.1">
<project id="conf-params" version="1.1">
  <settings><composition width="320" height="180" frame-rate="30/1" duration="3s" seed="21" /></settings>
  <timelines><timeline id="main" duration="3s"></timeline></timelines>
</project>
<script type="application/vnd.vhtml.program+javascript" seed="5" params="{&quot;accent&quot;:&quot;#6ee7ff&quot;,&quot;cards&quot;:&quot;3&quot;}">
const count = Number(vhtml.ctx.params.cards);
vhtml.setMetadata('accent', String(vhtml.ctx.params.accent));
vhtml.setMetadata('cards', String(count));
vhtml.addLane({ id: 'v', type: 'video', clips: [] });
for (let index = 0; index < count; index += 1) {
  vhtml.addScene({ id: 'p-' + index, html: '<div style="color:' + vhtml.ctx.params.accent + '">card</div>' });
  vhtml.addClip('v', { ref: 'scene:p-' + index, start: index, duration: 1 });
}
</script>
</vhtml></body></html>
